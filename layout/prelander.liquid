<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#050608">

  <title>
    {%- if page_title contains shop.name -%}
      {{ page_title }}
    {%- else -%}
      {{ page_title }} | {{ shop.name }}
    {%- endif -%}
  </title>

  {%- if page.excerpt != blank -%}
    <meta name="description" content="{{ page.excerpt | strip_html | escape | truncate: 160 }}">
  {%- elsif shop.description != blank -%}
    <meta name="description" content="{{ shop.description | escape | truncate: 160 }}">
  {%- endif -%}

  <!-- Canonical -->
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url"       content="{{ canonical_url }}">
  <meta property="og:title"     content="{{ page_title | escape }}">
  <meta property="og:type"      content="website">
  {%- if page.excerpt != blank -%}
    <meta property="og:description" content="{{ page.excerpt | strip_html | escape | truncate: 300 }}">
  {%- endif -%}

  <!-- Google Fonts: preconnect → preload → stylesheet (non-blocking swap trick) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- assign gfonts_url = 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:ital,wght@0,700;0,900;1,400;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300;1,9..40,400&display=swap' -%}
  <link rel="preload" as="style" href="{{ gfonts_url }}">
  <link rel="stylesheet" href="{{ gfonts_url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ gfonts_url }}"></noscript>

  <!-- Page stylesheet: preload then apply -->
  {%- assign css_url = 'max-motion-prelander.css' | asset_url -%}
  <link rel="preload" as="style" href="{{ css_url }}">
  <link rel="stylesheet" href="{{ css_url }}">

  <!-- Shopify-required head content (preview bar, analytics, etc.) -->
  {{ content_for_header }}
</head>
<body>

  <a class="mm-skip-link" href="#mm-story">Skip to content</a>

  {{ content_for_layout }}

  <script src="{{ 'max-motion-prelander.js' | asset_url }}" defer></script>
</body>
</html>
