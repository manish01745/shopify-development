<!-- CHAPTER 2 - THE PLAN -->
<section class="story-section alt">
  <div class="article">
    <div class="chapter reveal">
      <div class="chapter-num">{{ section.settings.chapter_number }}</div>
      <div>
        <div class="chapter-label">{{ section.settings.chapter_label }}</div>
        <div class="chapter-title">{{ section.settings.chapter_title }}</div>
      </div>
    </div>

    <p class="body-copy reveal">
      {{ section.settings.intro_text }}
    </p>

    <div class="timeline reveal" style="transition-delay:0.05s;">
      {% for block in section.blocks %}
        <div class="timeline-item">
          <div class="timeline-phase">{{ block.settings.phase }}</div>
          <div class="timeline-title">{{ block.settings.title }}</div>
          <div class="timeline-body">{{ block.settings.body }}</div>
        </div>
      {% endfor %}
    </div>

    <p class="body-copy reveal">
      {{ section.settings.outro_text }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Max Motion Chapter 2",
  "settings": [
    {
      "type": "text",
      "id": "chapter_number",
      "label": "Chapter Number",
      "default": "02"
    },
    {
      "type": "text",
      "id": "chapter_label",
      "label": "Chapter Label",
      "default": "The Strategy"
    },
    {
      "type": "textarea",
      "id": "chapter_title",
      "label": "Chapter Title",
      "default": "A System Built For<br><em>Max's Music.</em>"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro Text",
      "default": "GPM's approach with Max wasn't generic playlist pitching. <strong>Every genre has its own audience anatomy</strong>, different listening habits, different playlist ecosystems, different algorithmic triggers, and the campaign was built around Max's sound specifically. Three phases, executed in sequence, each one feeding the next."
    },
    {
      "type": "textarea",
      "id": "outro_text",
      "label": "Outro Text",
      "default": "Within weeks of the campaign launching, Max's catalogue started picking up serious traction. <strong>That early momentum wasn't the ceiling.</strong> It was the starting line for what came next."
    }
  ],
  "blocks": [
    {
      "type": "timeline_item",
      "name": "Timeline Item",
      "settings": [
        {
          "type": "text",
          "id": "phase",
          "label": "Phase Label",
          "default": "Phase 01 · Audience Expansion"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Genre-Specific Targeting"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body Text",
          "default": "Genre-native playlist placements positioned Max's tracks where his ideal listeners already live. No cross-genre noise. No off-target plays. Just real fans of the sound being introduced to an artist they hadn't heard yet."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "timeline_item",
        "settings": {
          "phase": "Phase 01 · Audience Expansion",
          "title": "Genre-Specific Targeting",
          "body": "Genre-native playlist placements positioned Max's tracks where his ideal listeners already live. No cross-genre noise. No off-target plays. Just real fans of the sound being introduced to an artist they hadn't heard yet."
        }
      },
      {
        "type": "timeline_item",
        "settings": {
          "phase": "Phase 02 · Momentum Building",
          "title": "Multi-Track Catalogue Promotion",
          "body": "One track gets you a spike. A catalogue gets you compounding. GPM promoted across multiple releases simultaneously so the algorithm started recommending Max as an artist, not just a single song. Performance data fed back into the next round of placements."
        }
      },
      {
        "type": "timeline_item",
        "settings": {
          "phase": "Phase 03 · Career Transition",
          "title": "Sustainable Growth Patterns",
          "body": "The endgame wasn't a viral moment. It was a foundation. Daily discovery, monthly listener retention, and a streaming presence consistent enough to unlock opportunities that simply weren't on the table at 4K listeners."
        }
      }
    ]
  }
}
{% endschema %}
