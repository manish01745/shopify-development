<!-- FOOTER -->
<footer class="max-motion-footer">
  <div class="footer-inner">
    <a href="#" class="footer-logo"><span>{{ section.settings.logo_first_part }}</span> {{ section.settings.logo_second_part }}</a>
    
    <ul class="footer-links">
      {% for block in section.blocks %}
        <li><a href="{{ block.settings.link }}">{{ block.settings.text }}</a></li>
      {% endfor %}
    </ul>

    <div class="footer-copy">
      {{ section.settings.copy_text }}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Max Motion Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_first_part",
      "label": "Logo First Part",
      "default": "GPM"
    },
    {
      "type": "text",
      "id": "logo_second_part",
      "label": "Logo Second Part",
      "default": "Music Group"
    },
    {
      "type": "textarea",
      "id": "copy_text",
      "label": "Copyright Text",
      "default": "© 2024 GPM Music Group. All rights reserved. GPM Music Group is an independent music promotion agency and is not affiliated with Spotify AB."
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link", "settings": { "text": "Terms of Service" } },
      { "type": "link", "settings": { "text": "Privacy Policy" } },
      { "type": "link", "settings": { "text": "Contact Support" } },
      { "type": "link", "settings": { "text": "Artist Dashboard" } }
    ]
  }
}
{% endschema %}
