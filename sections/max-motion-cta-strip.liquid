<!-- CTA STRIP -->
<div class="cta-strip">
  <div class="cta-strip-before"></div>
  <div class="cta-strip-inner">
    <div>
      <div class="cta-strip-heading">{{ section.settings.heading }}</div>
      <div class="cta-strip-sub">{{ section.settings.subheading }}</div>
    </div>
    <a href="{{ section.settings.link }}" class="btn-dark">{{ section.settings.button_text }}</a>
  </div>
</div>

{% schema %}
{
  "name": "Max Motion CTA Strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Audience Is Out There."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Let's put your music in front of it."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Start My Campaign →"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Max Motion CTA Strip"
    }
  ]
}
{% endschema %}
