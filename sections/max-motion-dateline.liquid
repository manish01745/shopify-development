<!-- DATELINE -->
<div class="dateline">
  <div class="dateline-inner">
    {% for block in section.blocks %}
      <div class="dateline-item">
        <div class="dateline-val">{{ block.settings.value }}</div>
        <div class="dateline-label">{{ block.settings.label }}</div>
      </div>
      {% unless forloop.last %}
        <div class="dateline-divider"></div>
      {% endunless %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Max Motion Dateline",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "661%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Listener Growth"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Max Motion Dateline",
      "blocks": [
        {
          "type": "stat",
          "settings": { "value": "661%", "label": "Listener Growth" }
        },
        {
          "type": "stat",
          "settings": { "value": "+26K", "label": "New Monthly Listeners" }
        },
        {
          "type": "stat",
          "settings": { "value": "7.6X", "label": "Audience Multiplier" }
        },
        {
          "type": "stat",
          "settings": { "value": "142K", "label": "Lead Track Streams" }
        }
      ]
    }
  ]
}
{% endschema %}
