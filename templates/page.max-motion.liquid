{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page.title }} | The Max Motion Story | GPM Music Group</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:ital,wght@0,700;0,900;1,400;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300;1,9..40,400&display=swap" rel="stylesheet">
  
  {{ 'max-motion.css' | asset_url | stylesheet_tag }}
</head>
<body>

<div class="max-motion-wrapper">
  {% section 'max-motion-nav' %}
  
  <main>
    {% section 'max-motion-hero' %}
    {% section 'max-motion-dateline' %}
    
    <div class="article">
      {% section 'max-motion-story-chapter-1' %}
      {% section 'max-motion-story-chapter-2' %}
      {% section 'max-motion-story-chapter-3' %}
    </div>

    {% section 'max-motion-cta-strip' %}

    <div class="article">
      {% section 'max-motion-story-chapter-4' %}
    </div>

    {% section 'max-motion-shows' %}
    {% section 'max-motion-playlist-breakdown' %}
    
    <div class="article">
      {% section 'max-motion-tiers' %}
    </div>

    {% section 'max-motion-banner' %}
    {% section 'max-motion-final-cta' %}
  </main>

  {% section 'max-motion-footer' %}
</div>

{{ 'max-motion.js' | asset_url | script_tag }}

</body>
</html>
